{
  "appId": "net.solariar.darox",
  "productName": "darox",
  "directories": {
    "output": "release",
    "buildResources": "resources"
  },
  "files": [
    "electron/dist/**/*",
    "out/**/*",
    "resources/icon.png",
    "package.json"
  ],
  "extraMetadata": {
    "main": "electron/dist/main.js"
  },
  "mac": {
    "category": "public.app-category.developer-tools",
    "icon": "resources/icon.icns",
    "target": ["dmg"]
  },
  "win": {
    "icon": "resources/icon.ico",
    "target": ["nsis"]
  },
  "linux": {
    "category": "Development",
    "synopsis": "Arox chat desktop and web client",
    "description": "Arox chat desktop and web client",
    "target": ["pacman"],
    "artifactName": "${name}-${version}-${arch}.pkg.tar.xz"
  },
  "pacman": {
    "depends": [
      "alsa-lib",
      "at-spi2-core",
      "cairo",
      "libcups",
      "dbus",
      "expat",
      "gcc-libs",
      "glib2",
      "glibc",
      "gtk3",
      "libdrm",
      "libx11",
      "libxcb",
      "libxcomposite",
      "libxdamage",
      "libxext",
      "libxfixes",
      "libxkbcommon",
      "libxrandr",
      "mesa",
      "nspr",
      "nss",
      "pango",
      "systemd-libs",
      "libsecret",
      "xdg-utils"
    ]
  }
}
