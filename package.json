{
  "name": "darox",
  "version": "0.0.1",
  "private": true,
  "description": "Arox chat desktop and web client",
  "homepage": "https://github.com/Arocial/darox",
  "author": {
    "name": "Solaria6",
    "email": "solariar@outlook.com"
  },
  "main": "electron/dist/main.js",
  "scripts": {
    "web:dev": "next dev -p 3140",
    "build": "next build",
    "build:check": "cross-env NEXT_DIST_DIR=.next-check next build",
    "start": "node scripts/serve.mjs",
    "lint": "biome check --write .",
    "format": "biome format --write .",
    "electron:compile": "tsc -p electron",
    "electron:dev": "cross-env AROX_API_TOKEN=1 DAROX_MANAGER_URL=http://127.0.0.1:3145 concurrently -k -n next,electron -c blue,magenta \"npm run web:dev\" \"wait-on http://localhost:3140 && npm run electron:compile && cross-env ELECTRON_DEV=1 electron electron/dist/main.js\"",
    "electron:dir": "cross-env NEXT_DIST_DIR=.next-package DAROX_STATIC_EXPORT=1 next build && node scripts/prepare-desktop-export.mjs && npm run electron:compile && electron-builder --dir",
    "electron:fast-run": "node scripts/run-unpacked.mjs",
    "electron:build": "cross-env NEXT_DIST_DIR=.next-package DAROX_STATIC_EXPORT=1 next build && node scripts/prepare-desktop-export.mjs && npm run electron:compile && electron-builder",
    "manager": "arox-manager",
    "web": "bash scripts/web.sh",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "3.0.99",
    "@assistant-ui/react": "^0.14.23",
    "@assistant-ui/react-ai-sdk": "^1.3.37",
    "@assistant-ui/react-markdown": "^0.14.4",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/postcss": "^4.2.1",
    "ai": "6.0.97",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "katex": "^0.19.0",
    "lucide-react": "^0.576.0",
    "next": "^15.5.9",
    "radix-ui": "^1.6.0",
    "react": "^18",
    "react-dom": "^18",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "sonner": "^2.0.7",
    "streamdown": "^2.3.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.11",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/node": "20.17.24",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.14",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "png2icons": "^2.0.1",
    "tailwindcss": "^4.2.1",
    "typescript": "5.8.3",
    "wait-on": "^9.0.10"
  },
  "overrides": {
    "katex": "$katex"
  }
}
